# OmNexus Core API - Environment Variables

# Resend API Key (for emails)
RESEND_API_KEY=re_your_resend_api_key_here

# Supabase Configuration
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Email Settings
FROM_EMAIL=onboarding@resend.dev  # Geliştirme aşamasında bu kalsın

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=https://straxon-qart.vercel.app/api/v1/straxon/auth/github/callback
BASE_URL=https://straxon-qart.vercel.app
FRONTEND_URL=https://straxon-qart.vercel.app

# Gemini AI (Jarvis Beyni)
GEMINI_API_KEY=your_gemini_api_key_here

